    "swagger": "2.0",
    "info": {
        "description": "OpenIM Server 提供即时通讯服务的 REST API 接口文档\n\n## 认证方式\n大部分接口需要在 Header 中携带 token 进行认证：\n- Header名称: token\n- 获取方式: 调用 /auth/get_user_token 接口\n\n## 接口规范\n- 所有接口均使用 POST 方法\n- Content-Type: application/json\n- 响应格式: JSON",
        "title": "OpenIM Server API",
        "contact": {
            "name": "OpenIM Support",
            "url": "https://github.com/openimsdk/open-im-server",
            "email": "contact@openim.io"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "3.8"
    },
    "host": "localhost:10002",
    "basePath": "/",
    "paths": {
