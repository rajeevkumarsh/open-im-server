                            "$ref": "#/definitions/apistruct.ApiResponse"
                        }
                    },
                    "400": {
                        "description": "请求参数错误",
                        "schema": {
                            "$ref": "#/definitions/apistruct.ApiResponse"
                        }
                    },
                    "401": {
                        "description": "权限不足",
                        "schema": {
                            "$ref": "#/definitions/apistruct.ApiResponse"
                        }
                    }
                }
            }
        },
